# Copie para .env e ajuste.  (rode o servidor de dentro de jokenpo/)

# === Agentes (Anthropic / Claude) — obrigatório p/ narração e VLM ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Opcional: provedores de fallback (a cadeia é anthropic -> openai -> cerebras)
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# === Mão HACKberry (serial) — lido pelo Thoth ===
SERIAL_PORT=COM16                 # confirme com: python ../scripts/check_devices.py
SERIAL_BAUD=115200
SERIAL_HEARTBEAT_MS=300

# === Câmera (visão computacional) ===
CAMERA_INDEX=1                    # Logitech; confirme com check_devices.py
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# === Voz (TTS do Thoth) ===
TTS_PROVIDER=edge                 # edge (online, neural, PT-BR) | piper (offline)
EDGE_VOICE=pt-BR-ThalitaMultilingualNeural

# === Opções do jogo ===
GAME_VLM_FALLBACK=1               # 1 = usa Claude vision quando o MediaPipe fica em dúvida
GAME_SERVER_AUDIO=0               # 1 = também toca a narração no alto-falante do servidor
GAME_SAMPLE_WINDOW_S=0.7          # janela (s) de votação do gesto no "já"
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001
