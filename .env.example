# Copie para `.env` e ajuste. NUNCA versione o .env (ver .gitignore).

# === Hardware / serial (Arduino) ===
SERIAL_PORT=COM19                   # Windows: COMx (varia ao reconectar) | Linux: /dev/ttyUSB0; confirme: check_devices.py
SERIAL_BAUD=115200
SERIAL_HEARTBEAT_MS=300

# === Câmera (visão computacional) ===
CAMERA_INDEX=1                      # Logitech — confirme com: python scripts/check_devices.py
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# === App / API ===
THOTH_ENV=dev                       # dev | prod (seleciona configs/<env>.yaml)
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# === Agente conversacional (voz) ===
ASSISTANT_NAME=Marco
# Cérebro (LLM) — endpoint OpenAI-compatible, plugável:
#   cerebras | groq | ollama (LLM local) | custom (Rio-3.5-397B: provider=custom + LLM_BASE_URL do vLLM)
#   ollama: rode `ollama serve`; LLM_MODEL = ex. qwen2.5 / llama3.1 / deepseek-r1 (offline, grátis)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b        # fiel a ferramentas; alt: llama-3.3-70b-versatile
# LLM_BASE_URL: vazio = padrão do provedor; ou http://SEU_VLLM:8000/v1 (Rio via vLLM)
LLM_BASE_URL=
CEREBRAS_API_KEY=csk-...
GROQ_API_KEY=gsk_...
# Visão (VLM multimodal) — skills ver_cena/ler_texto/jokenpô (usa a chave do provedor)
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Cidade padrão da skill de clima (quando o usuário não disser a cidade)
DEFAULT_CITY=Porto Alegre
# Ouvido (STT): groq (Whisper na nuvem, usa GROQ_API_KEY) | local (faster-whisper)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
# Voz (TTS): edge (online, neural, PT-BR, grátis, sem chave) | piper (offline)
TTS_PROVIDER=edge
# Vozes edge PT-BR: pt-BR-ThalitaMultilingualNeural | pt-BR-AntonioNeural | pt-BR-FranciscaNeural
EDGE_VOICE=pt-BR-ThalitaMultilingualNeural
EDGE_RATE=+0%                        # velocidade (ex.: +10%, -5%)
EDGE_PITCH=+0Hz                     # tom (ex.: +20Hz, -10Hz)
# Piper (só com TTS_PROVIDER=piper) — baixe com: python scripts/download_piper.py
PIPER_VOICE=pt_BR-faber-medium
# MIC_DEVICE: vazio = microfone padrão do Windows
MIC_DEVICE=
