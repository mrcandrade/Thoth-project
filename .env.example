# Copie para `.env` e ajuste. NUNCA versione o .env (ver .gitignore).

# === Hardware / serial (Arduino) ===
SERIAL_PORT=COM17                   # Windows: COMx | Linux: /dev/ttyUSB0 ou /dev/ttyACM0
SERIAL_BAUD=115200
SERIAL_HEARTBEAT_MS=300

# === Câmera (visão computacional) ===
CAMERA_INDEX=1                      # Logitech — confirme com: python scripts/check_devices.py
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# === App / API ===
THOTH_ENV=dev                       # dev | prod (seleciona configs/<env>.yaml)
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
